# ══════════════════════════════════════════════════════════════
# CONFIGURAÇÃO PARA RENDER.COM (Plano Gratuito)
# ══════════════════════════════════════════════════════════════
#
# INSTRUÇÕES:
# 1. Criar conta no Render.com (https://render.com)
# 2. Criar um "Web Service" conectando ao repositório GitHub
# 3. Criar um "MySQL Database" no Render
# 4. Copiar as variáveis de ambiente da BD para o Web Service
# 5. Adicionar as variáveis abaixo no painel "Environment" do Web Service
#
# NOTA: O Render gera automaticamente FLASK_SECRET_KEY
# ══════════════════════════════════════════════════════════════

# ── Flask ────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=production

# ── Base de Dados MySQL (preencher com dados do Render) ─────
# Estas variáveis são preenchidas automaticamente pelo Render
# quando liga a base de dados ao Web Service
# MYSQL_HOST=dpg-xxxxx-a.oregon-postgres.render.com
# MYSQL_USER=plagio_user
# MYSQL_PASSWORD=xxxxx
# MYSQL_DB=plagio

# ── OpenRouter API (Embeddings) ─────────────────────────────
# Obter em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_EMBEDDING_URL=https://openrouter.ai/api/v1/embeddings
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=3

# ── Serper (Google Search - Opcional) ────────────────────────
# Obter em: https://serper.dev
SERPER_API_KEY=coloque_a_chave_aqui
SERPER_API_URL=https://google.serper.dev/search
SERPER_TIMEOUT_SECONDS=15
SERPER_MAX_RETRIES=2

# ── Detecção de Plágio ──────────────────────────────────────
LIMIAR_PLAGIO=0.85
CHUNK_SIZE=200
CHUNK_OVERLAP=50

# ── LLM / IA (Opcional - Fase 2) ───────────────────────────
# Para usar LLM no Render, configure um dos provedores:
#
# Opção 1: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-xxxxx
#
# Opção 2: Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=sk-ant-xxxxx
#
# Opção 3: Ollama Remoto (se tiver servidor próprio)
# LLM_PROVIDER=ollama
# OLLAMA_URL=https://seu-servidor.com
# LLM_API_KEY=token
# LLM_MODEL=llama3
