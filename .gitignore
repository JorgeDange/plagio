# ══════════════════════════════════════════════════════════════
# .gitignore — Arquivos que NÃO devem subir para o GitHub
# ══════════════════════════════════════════════════════════════

# ── Variáveis de Ambiente (SENSÍVEIS) ────────────────────────
.env
.env.local
.env.production

# ── Ambiente Virtual Python ──────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Cache Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo

# ── Base de Dados Local ──────────────────────────────────────
instance/
*.db
*.sqlite
*.sqlite3

# ── ChromaDB (dados vetoriais) ───────────────────────────────
chroma_data/

# ── Uploads (documentos dos utilizadores) ────────────────────
uploads/
*.pdf
*.docx
*.doc

# ── Relatórios Gerados ──────────────────────────────────────
relatorios/
relatorios/*.html

# ── Modelos de IA (pesados) ─────────────────────────────────
app/models/
*.pt
*.bin
*.onnx

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── IDE / Editores ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Sistema Operativo ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ── Build / Distribuição ────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Temporários ─────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup

# ── Migrações executadas (podem ser regeneradas) ────────────
# db/migrations/*.sql  ← DESCOMENTAR se quiser ignorar migrações

# ── Documentação local (não precisa de ir para o repo) ──────
docs/
end.md
estrut.md
CHANGELOG.md
